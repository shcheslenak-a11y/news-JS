{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist/",
    "noImplicitAny": true,
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}